# Copy to .env for local development. In k3s these come from the ConfigMap and
# the InfisicalSecret at path /feuerwehr - the names are unchanged from the
# Spring deployment, so neither has to be touched.

APP_PROFILE=dev
SERVER_PORT=8080

# A jdbc:postgresql:// URL is accepted and translated (see app/config.py), so
# the existing ConfigMap value works as-is.
DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/ff_trainingskarte
DB_USER=postgres
DB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PASSWORD=
# Index 1 in the cluster keeps our sessions apart from the Java app's.
REDIS_DB=0

# 8 hours; a training session never outlasts that.
SESSION_TTL_SECONDS=28800
# Set to true behind TLS (feuerwehr.slin.io), false for plain-HTTP local dev.
SESSION_COOKIE_SECURE=false

# Mail. Off by default: the relay is cluster-internal and a dev machine cannot
# resolve it. With MAIL_ENABLED=false the app logs what it would have sent -
# enough to copy the verification or reset link out of the log while developing.
MAIL_ENABLED=false
SMTP_HOST=mail-relay.mail.svc.cluster.local
SMTP_PORT=587
SMTP_FROM=noreply@slin.io

# Base for the links in mails. In the cluster this is https://ffw-funk.slin.io.
PUBLIC_BASE_URL=http://localhost:8080
